{
  "openapi": "3.0.1",
  "info": {
    "title": "JWTWebAPIDemo",
    "version": "v1"
  },
  "paths": {
    "/api/Payments/{id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Retrieves payment transaction details by payment ID.\r\n[Allowed Roles: Passenger, Dealer, Admin, SuperAdmin]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Processes or creates a new payment for a booking using Razorpay gateway integration.\r\n[Allowed Roles: Passenger, Dealer]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessPaymentDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessPaymentDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessPaymentDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Payments/{id}/refund": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Initiates a refund for a processed payment transaction.\r\n[Allowed Roles: Admin, SuperAdmin, FinancialAdmin]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProcessPaymentDto": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "userEmail": {
            "type": "string",
            "nullable": true
          },
          "userName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter token as: Bearer {your token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}