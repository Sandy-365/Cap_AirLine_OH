      "get": {
        "tags": [
          "CheckIns"
        ],
        "summary": "Generates digital boarding pass details for a check-in record.\r\n[Allowed Roles: Passenger, Admin, Staff]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
