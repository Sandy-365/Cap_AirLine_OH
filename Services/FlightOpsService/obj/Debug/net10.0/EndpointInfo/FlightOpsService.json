        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/CheckIns/{id}": {
      "get": {
        "tags": [
          "CheckIns"
        ],
        "summary": "Retrieves a single check-in record by ID. Returns 404 if not found.\r\n[Allowed Roles: Passenger, Admin, Staff]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
