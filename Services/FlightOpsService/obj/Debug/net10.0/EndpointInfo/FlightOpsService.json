    "/api/Flights": {
      "get": {
        "tags": [
          "Flights"
        ],
        "summary": "Retrieves all flights or searches flights if source, destination, or date are provided.\r\n[Allowed Roles: Public (None required)]",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departureDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Flights"
        ],
        "summary": "Creates a new flight with route, schedule, pricing, and seat configuration. Sets initial status to Scheduled.\r\n[Allowed Roles: Admin, SuperAdmin]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlightDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlightDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlightDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Flights/{id}": {
      "get": {
        "tags": [
          "Flights"
        ],
        "summary": "Retrieves a single flight by ID. Returns 404 if not found.\r\n[Allowed Roles: Public (None required)]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Flights"
        ],
        "summary": "Updates flight details (departure/arrival times, gate, aircraft, crew). Only updates non-null fields.\r\n[Allowed Roles: Admin, SuperAdmin]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlightDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlightDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlightDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Flights"
        ],
        "summary": "Permanently removes a flight from the system.\r\n[Allowed Roles: Admin, SuperAdmin]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
