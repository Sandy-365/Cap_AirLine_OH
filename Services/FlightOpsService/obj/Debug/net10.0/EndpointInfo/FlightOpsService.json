          {
            "name": "passengerName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flightNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flightId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "departureTime",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "fare",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineCheckInDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineCheckInDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineCheckInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
