{
  "openapi": "3.0.1",
  "info": {
    "title": "FlightOpsService API",
    "version": "v1"
  },
  "paths": {
    "/api/Bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Retrieves all bookings, or filters by PNR, userId, flightId, or scheduleId.\r\n[Allowed Roles: Public / Authorized Users]",
        "parameters": [
          {
            "name": "pnr",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "flightId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "scheduleId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Creates a new booking.\r\n[Allowed Roles: Passenger, Dealer]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings/{id}": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Gets a booking by its ID.\r\n[Allowed Roles: Passenger, Dealer, Admin]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings/{id}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancels a booking.\r\n[Allowed Roles: Passenger, Dealer]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings/passengers/{passengerId}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancels a specific passenger from a booking.\r\n[Allowed Roles: Passenger, Dealer]",
        "parameters": [
          {
            "name": "passengerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelPassengerDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelPassengerDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CancelPassengerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings/occupied-seats": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Gets the occupied seats for a flight schedule.\r\n[Allowed Roles: Passenger, Dealer, Admin]",
        "parameters": [
          {
            "name": "flightId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "scheduleId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings/{id}/confirm-payment": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Confirms booking payment and transitions booking status to Confirmed.\r\n[Allowed Roles: Authorized Users / Payment Service]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "transactionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "paymentMethod",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/CheckIns": {
      "get": {
        "tags": [
          "CheckIns"
        ],
        "summary": "Retrieves all check-in records, or filters by bookingId.\r\n[Allowed Roles: Logged-in Users]",
        "parameters": [
          {
            "name": "bookingId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "CheckIns"
        ],
        "summary": "Performs passenger or staff counter Check-In.\r\n[Allowed Roles: Passenger, Admin, GroundStaff, Staff]",
        "parameters": [
          {
            "name": "passengerName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flightNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flightId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "departureTime",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "fare",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineCheckInDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineCheckInDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineCheckInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/CheckIns/{id}": {
      "get": {
        "tags": [
          "CheckIns"
        ],
        "summary": "Retrieves a single check-in record by ID. Returns 404 if not found.\r\n[Allowed Roles: Passenger, Admin, Staff]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Flights": {
      "get": {
        "tags": [
          "Flights"
        ],
        "summary": "Retrieves all flights or searches flights if source, destination, or date are provided.\r\n[Allowed Roles: Public (None required)]",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departureDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Flights"
        ],
        "summary": "Creates a new flight with route, schedule, pricing, and seat configuration. Sets initial status to Scheduled.\r\n[Allowed Roles: Admin, SuperAdmin]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlightDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlightDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlightDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Flights/{id}": {
      "get": {
        "tags": [
          "Flights"
        ],
        "summary": "Retrieves a single flight by ID. Returns 404 if not found.\r\n[Allowed Roles: Public (None required)]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Flights"
        ],
        "summary": "Updates flight details (departure/arrival times, gate, aircraft, crew). Only updates non-null fields.\r\n[Allowed Roles: Admin, SuperAdmin]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlightDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlightDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlightDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Flights"
        ],
        "summary": "Permanently removes a flight from the system.\r\n[Allowed Roles: Admin, SuperAdmin]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Flights/schedules": {
      "get": {
        "tags": [
          "Flights"
        ],
        "summary": "Retrieves all flight schedules, or searches schedules if source, destination, date, or flightId are provided.\r\n[Allowed Roles: Public (None required)]",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departureDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flightId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Flights"
        ],
        "summary": "Creates a new flight schedule instance from a flight template.\r\n[Allowed Roles: Admin, SuperAdmin, Staff]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScheduleDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScheduleDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScheduleDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookingPassengerRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "aadharCardNo": {
            "type": "string",
            "nullable": true
          },
          "passportNumber": {
            "type": "string",
            "nullable": true
          },
          "nationality": {
            "type": "string",
            "nullable": true
          },
          "dietaryRequirements": {
            "type": "string",
            "nullable": true
          },
          "medicalNeeds": {
            "type": "string",
            "nullable": true
          },
          "seatNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CancelPassengerDto": {
        "required": [
          "cancellationReason"
        ],
        "type": "object",
        "properties": {
          "cancellationReason": {
            "maxLength": 500,
            "minLength": 5,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "flightId": {
            "type": "integer",
            "format": "int32"
          },
          "scheduleId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "seatClass": {
            "type": "string",
            "nullable": true
          },
          "baggageWeight": {
            "type": "number",
            "format": "double"
          },
          "passengerCount": {
            "type": "integer",
            "format": "int32"
          },
          "passengers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingPassengerRequestDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateFlightDto": {
        "type": "object",
        "properties": {
          "flightNumber": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "nullable": true
          },
          "destination": {
            "type": "string",
            "nullable": true
          },
          "departureTime": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalTime": {
            "type": "string",
            "format": "date-time"
          },
          "aircraft": {
            "type": "string",
            "nullable": true
          },
          "totalSeats": {
            "type": "integer",
            "format": "int32"
          },
          "economySeats": {
            "type": "integer",
            "format": "int32"
          },
          "businessSeats": {
            "type": "integer",
            "format": "int32"
          },
          "firstSeats": {
            "type": "integer",
            "format": "int32"
          },
          "economyPrice": {
            "type": "number",
            "format": "double"
          },
          "businessPrice": {
            "type": "number",
            "format": "double"
          },
          "firstClassPrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateScheduleDto": {
        "type": "object",
        "properties": {
          "flightId": {
            "type": "integer",
            "format": "int32"
          },
          "departureTime": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalTime": {
            "type": "string",
            "format": "date-time"
          },
          "gate": {
            "type": "string",
            "nullable": true
          },
          "economySeats": {
            "type": "integer",
            "format": "int32"
          },
          "businessSeats": {
            "type": "integer",
            "format": "int32"
          },
          "firstSeats": {
            "type": "integer",
            "format": "int32"
          },
          "economyPrice": {
            "type": "number",
            "format": "double"
          },
          "businessPrice": {
            "type": "number",
            "format": "double"
          },
          "firstClassPrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "OnlineCheckInDto": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int32"
          },
          "passengerId": {
            "type": "integer",
            "format": "int32"
          },
          "seatNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateFlightDto": {
        "type": "object",
        "properties": {
          "departureTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "arrivalTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "gate": {
            "type": "string",
            "nullable": true
          },
          "aircraft": {
            "type": "string",
            "nullable": true
          },
          "crewAssignment": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter token as: Bearer {your token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
    {
      "name": "Flights",
      "description": "Flight operations, schedules, and route management"
    },
    {
      "name": "Bookings",
      "description": "Ticket bookings and reservations"
    },
    {
      "name": "CheckIns",
      "description": "Online and airport counter check-in"
    }
  ]
}