{
  "openapi": "3.0.1",
  "info": {
    "title": "FlightOpsService API",
    "version": "v1"
  },
  "paths": {
    "/api/Baggages": {
      "get": {
        "tags": [
          "Baggages"
        ],
        "summary": "Retrieves all registered baggage, or tracks by trackingNumber or bookingId.\r\n[Allowed Roles: Logged-in Users]",
        "parameters": [
          {
            "name": "bookingId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "trackingNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Baggages"
        ],
        "summary": "Registers new checked baggage at the counter.\r\n[Allowed Roles: GroundStaff, Staff]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddBaggageDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddBaggageDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddBaggageDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Baggages/{id}": {
      "get": {
        "tags": [
          "Baggages"
        ],
        "summary": "Retrieves baggage tracking details by baggage ID.\r\n[Allowed Roles: GroundStaff, Passenger, Dealer, Staff]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Baggages/{id}/status": {
      "put": {
        "tags": [
          "Baggages"
        ],
        "summary": "Updates baggage tracking status (CheckedIn, Loaded, Claimed, Lost).\r\n[Allowed Roles: GroundStaff, Staff]",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBaggageStatusDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBaggageStatusDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBaggageStatusDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Retrieves all bookings, or filters by PNR, userId, flightId, or scheduleId.\r\n[Allowed Roles: Public / Authorized Users]",
