              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelPassengerDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CancelPassengerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings/occupied-seats": {
      "get": {
        "tags": [
          "Bookings"
