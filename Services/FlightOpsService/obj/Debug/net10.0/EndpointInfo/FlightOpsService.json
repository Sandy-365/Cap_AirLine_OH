            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BookSeatDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BookSeatDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
