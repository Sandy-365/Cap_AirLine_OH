          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Bookings/passengers/{passengerId}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancels a specific passenger from a booking.\r\n[Allowed Roles: Passenger, Dealer]",
        "parameters": [
          {
            "name": "passengerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
