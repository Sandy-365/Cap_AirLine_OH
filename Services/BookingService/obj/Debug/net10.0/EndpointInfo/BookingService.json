  "components": {
    "schemas": {
      "CancelPassengerDto": {
        "required": [
          "cancellationReason"
        ],
        "type": "object",
        "properties": {
          "cancellationReason": {
            "maxLength": 500,
            "minLength": 5,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "flightId": {
            "type": "integer",
            "format": "int32"
          },
          "scheduleId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "seatClass": {
            "type": "string",
            "nullable": true
          },
          "baggageWeight": {
            "type": "number",
            "format": "double"
          },
          "passengerCount": {
            "type": "integer",
            "format": "int32"
          },
          "userEmail": {
            "type": "string",
            "nullable": true
          },
          "userName": {
            "type": "string",
            "nullable": true
          },
          "totalAmount": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreatePassengerDto": {
        "required": [
          "aadharCardNo",
          "age",
          "gender",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "age": {
            "maximum": 120,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "gender": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "aadharCardNo": {
            "minLength": 1,
            "pattern": "^\\d{12}$",
            "type": "string"
          },
          "seatNumber": {
            "type": "string",
            "nullable": true
          },
          "fare": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter token as: Bearer {your token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}