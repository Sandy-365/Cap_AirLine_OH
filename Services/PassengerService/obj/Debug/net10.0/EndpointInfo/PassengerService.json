{
  "openapi": "3.0.4",
  "info": {
    "title": "PassengerService Web API",
    "version": "v1"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "PassengerAuth"
        ],
        "summary": "Authenticates passenger credentials and returns JWT token. \r\n[Allowed Roles: Public (None required)]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerLoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerLoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "PassengerAuth"
        ],
        "summary": "Registers a new passenger account with email, password, and optional profile fields.\r\n[Allowed Roles: Public (None required)]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerRegisterDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerRegisterDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerRegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/verify": {
      "post": {
        "tags": [
          "PassengerAuth"
        ],
        "summary": "Verifies passenger email account using the OTP received via email and returns JWT token upon successful verification.\r\n[Allowed Roles: Public (None required)]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerVerifyDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerVerifyDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerVerifyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/resend-verification": {
      "post": {
        "tags": [
          "PassengerAuth"
        ],
        "summary": "Resends verification OTP to the specified passenger email address.\r\n[Allowed Roles: Public (None required)]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/force-verify": {
      "post": {
        "tags": [
          "PassengerAuth"
        ],
        "summary": "Directly verifies passenger email address and returns JWT token (bypasses OTP check for testing/convenience).\r\n[Allowed Roles: Public (None required)]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "PassengerAuth"
        ],
        "summary": "Generates a password reset OTP token and returns it directly in the response so the website can alert it (no email required).\r\n[Allowed Roles: Public (None required)]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": [
          "PassengerAuth"
        ],
        "summary": "Resets passenger password using the mandatory OTP token generated from forgot-password.\r\n[Allowed Roles: Public (None required)]",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerResetPasswordDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerResetPasswordDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Passengers/users": {
      "get": {
        "tags": [
          "Passengers"
        ],
        "summary": "Retrieves all passengers.\r\n[Allowed Roles: Admin, SuperAdmin, HR, Staff]",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Passengers/users/{userId}": {
      "delete": {
        "tags": [
          "Passengers"
        ],
        "summary": "Permanently deletes a passenger profile.\r\n[Allowed Roles: Admin, SuperAdmin]",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Passengers"
        ],
        "summary": "Retrieves a passenger profile by ID.\r\n[Allowed Roles: Passenger (own profile), Admin, SuperAdmin, Staff]",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Passengers/users/{userId}/profile": {
      "put": {
        "tags": [
          "Passengers"
        ],
        "summary": "Updates a passenger's profile information.\r\n[Allowed Roles: Passenger (own profile), Admin, SuperAdmin]",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerUpdateProfileDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerUpdateProfileDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerUpdateProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Passengers/users/{userId}/status": {
      "put": {
        "tags": [
          "Passengers"
        ],
        "summary": "Activates or deactivates a passenger account.\r\n[Allowed Roles: Admin, SuperAdmin, HR]",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerUpdateStatusDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerUpdateStatusDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerUpdateStatusDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PassengerForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PassengerLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PassengerRegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "nullable": true
          },
          "aadhar": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PassengerResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PassengerUpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "nullable": true
          },
          "aadhar": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "passportNumber": {
            "type": "string",
            "nullable": true
          },
          "nationality": {
            "type": "string",
            "nullable": true
          },
          "profileImage": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "travelPreferences": {
            "$ref": "#/components/schemas/TravelPreferencesDto"
          },
          "savedPassengers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SavedPassengerDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PassengerUpdateStatusDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PassengerVerifyDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SavedPassengerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "aadhar": {
            "type": "string",
            "nullable": true
          },
          "passportNumber": {
            "type": "string",
            "nullable": true
          },
          "nationality": {
            "type": "string",
            "nullable": true
          },
          "dietaryRequirements": {
            "type": "string",
            "nullable": true
          },
          "medicalNeeds": {
            "type": "string",
            "nullable": true
          },
          "medicalAlerts": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TravelPreferencesDto": {
        "type": "object",
        "properties": {
          "mealType": {
            "type": "string",
            "nullable": true
          },
          "medicalNeeds": {
            "type": "string",
            "nullable": true
          },
          "medicalAlerts": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter token as: Bearer {your token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}